# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# Remitente verificado en Resend
LEAD_FROM_EMAIL="Boreas <leads@boreas.one>"
# Destinatario de las notificaciones de lead
LEAD_TO_EMAIL=hola@boreas.one

# Checkout Pro — Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=xxxxxxxx
NEXT_PUBLIC_SITE_URL=https://www.boreas.one

# Supabase Postgres — usa la cadena del Transaction pooler (puerto 6543)
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres
# Solo para ejecutar migraciones localmente: Direct o Session pooler (puerto 5432)
SUPABASE_DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres
# Sal aleatoria de al menos 32 caracteres para anonimizar IPs del rate limit
RATE_LIMIT_SALT=replace-with-a-long-random-value
# Vercel Cron lo envía como Bearer token al reintentar correos fallidos
CRON_SECRET=replace-with-another-long-random-value
